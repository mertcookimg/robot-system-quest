{
  "name": "robot-system-quest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ブラウザでROS 2のコンセプトを学べるロボット教育ゲーム",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts && npm run check:stages",
    "gen:stages": "node scripts/gen-stage-list.mjs",
    "check:stages": "node scripts/gen-stage-list.mjs --check"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.5"
  }
}
